---
import { Image } from 'astro:assets';
import placeholder from '../assets/avatar-placeholder.jpg';

interface Props {
  name: string;
}
const { name } = Astro.props;
---

<Image
  src={placeholder}
  alt={`Avatar de ${name}`}
  width={448}
  height={480}
  loading="lazy"
  class="w-full h-full object-cover"
/>
