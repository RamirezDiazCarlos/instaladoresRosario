---
const year = new Date().getFullYear();
---

<footer class="bg-dark border-t border-white/5">

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="grid grid-cols-1 sm:grid-cols-[1fr_auto_auto] gap-8 sm:gap-12">

      <div class="max-w-xs">
        <a href="/" class="inline-flex items-center gap-2.5 mb-4 group" aria-label="InstaladoresRosario - inicio">
          <div class="w-7 h-7 rounded-lg bg-ice flex items-center justify-center flex-shrink-0">
            <svg width="15" height="15" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <circle cx="9" cy="9" r="2" fill="white"/>
              <line x1="9" y1="2" x2="9" y2="5" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
              <line x1="9" y1="13" x2="9" y2="16" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
              <line x1="2" y1="9" x2="5" y2="9" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
              <line x1="13" y1="9" x2="16" y2="9" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
              <line x1="4.05" y1="4.05" x2="6.17" y2="6.17" stroke="white" stroke-width="1.3" stroke-linecap="round" opacity="0.7"/>
              <line x1="11.83" y1="11.83" x2="13.95" y2="13.95" stroke="white" stroke-width="1.3" stroke-linecap="round" opacity="0.7"/>
              <line x1="4.05" y1="13.95" x2="6.17" y2="11.83" stroke="white" stroke-width="1.3" stroke-linecap="round" opacity="0.7"/>
              <line x1="11.83" y1="6.17" x2="13.95" y2="4.05" stroke="white" stroke-width="1.3" stroke-linecap="round" opacity="0.7"/>
            </svg>
          </div>
          <span class="font-display font-700 text-white text-base">
            Instaladores<span class="text-ice">Rosario</span>
          </span>
        </a>
        <p class="text-white/40 text-sm leading-relaxed">
          Directorio de técnicos instaladores de aire acondicionado en Rosario, Santa Fe. Conectamos vecinos con profesionales del rubro.
        </p>
      </div>

      <div>
        <h4 class="text-xs font-semibold text-white/40 uppercase tracking-widest mb-4">Directorio</h4>
        <ul class="flex flex-col gap-2.5" role="list">
          <li><a href="/#profesionales" class="text-sm text-white/55 hover:text-white transition-colors">Profesionales</a></li>
          <li><a href="/#como-funciona" class="text-sm text-white/55 hover:text-white transition-colors">Cómo funciona</a></li>
          <li><a href="/#listar" class="text-sm text-white/55 hover:text-white transition-colors">Publicar perfil</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-xs font-semibold text-white/40 uppercase tracking-widest mb-4">Información</h4>
        <ul class="flex flex-col gap-2.5" role="list">
          <li><a href="/#listar" class="text-sm text-white/55 hover:text-white transition-colors">Contacto</a></li>
        </ul>
      </div>

    </div>
  </div>

  <div class="border-t border-white/5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5">
      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-3 sm:gap-6">
        <p class="text-xs text-white/30">
          &copy; {year} InstaladoresRosario. Todos los derechos reservados.
        </p>
        <p class="text-xs text-white/25 sm:ml-auto">
          Desarrollado por <a href="https://www.kerneldev.com.ar/" target="_blank" rel="noopener noreferrer" class="text-white/40 hover:text-white/70 transition-colors">KERNEL</a>
        </p>
        <p class="text-xs text-white/20 sm:ml-auto max-w-lg">
          <strong class="text-white/30">Aviso:</strong> InstaladoresRosario es un directorio informativo independiente. No controlamos la validez vigente de las matrículas en tiempo real. Antes de contratar, verificá la habilitación del profesional.
        </p>
      </div>
    </div>
  </div>

</footer>
