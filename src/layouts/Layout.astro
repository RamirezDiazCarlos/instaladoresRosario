---
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  canonicalURL?: string;
  ogImage?: string;
}

const {
  title = "Instaladores de Aire Acondicionado en Rosario | Directorio",
  description = "Directorio de técnicos instaladores de aire acondicionado en Rosario y alrededores. Filtrá por zona o servicio y contactá por WhatsApp, sin intermediarios.",
  canonicalURL = Astro.url.href,
  ogImage = "https://instaladoresrosario.com.ar/og-image.jpeg",
} = Astro.props;
---

<!doctype html>
<html lang="es-AR">
  <head>
    <!-- Google AdSense -->
    <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1089549894771576"
     crossorigin="anonymous"></script>

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-NWJV1VKE8J"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      // send_page_view: false — con ClientRouter las navegaciones no recargan la
      // página, así que el page_view se dispara a mano en cada astro:page-load.
      gtag('config', 'G-NWJV1VKE8J', { send_page_view: false });
    </script>
    <ClientRouter />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content="InstaladoresRosario" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Canonical + Sitemap -->
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <!-- fuentes (no bloqueantes) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Zilla+Slab:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Zilla+Slab:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Zilla+Slab:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      />
    </noscript>

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{title}</title>

    <!-- JSON-LD: WebSite + Organization -->
    <script is:inline type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "WebSite",
            "@id": "https://instaladoresrosario.com.ar/#website",
            "name": "InstaladoresRosario",
            "description": "Directorio de técnicos instaladores de aire acondicionado en Rosario, Santa Fe",
            "url": "https://instaladoresrosario.com.ar",
            "inLanguage": "es-AR"
          },
          {
            "@type": "Organization",
            "@id": "https://instaladoresrosario.com.ar/#organization",
            "name": "InstaladoresRosario",
            "url": "https://instaladoresrosario.com.ar",
            "description": "Directorio de técnicos instaladores de aire acondicionado en Rosario, Santa Fe.",
            "logo": {
              "@type": "ImageObject",
              "url": "https://instaladoresrosario.com.ar/favicon-96x96.png"
            },
            "address": {
              "@type": "PostalAddress",
              "addressLocality": "Rosario",
              "addressRegion": "Santa Fe",
              "addressCountry": "AR"
            },
            "areaServed": {
              "@type": "City",
              "name": "Rosario",
              "containedInPlace": { "@type": "State", "name": "Santa Fe" }
            },
            "sameAs": []
          }
        ]
      }
    </script>

    <!-- Named slot for page-level head content (JSON-LD, etc.) -->
    <slot name="head" />

    <script is:inline>
      // Re-envía el page_view en cada transición de ClientRouter (incluida la carga inicial).
      document.addEventListener('astro:page-load', function () {
        if (window.gtag) {
          gtag('event', 'page_view', {
            page_location: location.href,
            page_path: location.pathname,
            page_title: document.title,
          });
        }
      });

      // Contadores animados: cualquier elemento con [data-count-to] cuenta desde 0
      // hasta el valor indicado. [data-count-immediate] arranca al cargar (ya visible,
      // p. ej. el Hero); el resto espera a entrar en pantalla (IntersectionObserver).
      document.addEventListener('astro:page-load', function () {
        var prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var counters = document.querySelectorAll('[data-count-to]');

        counters.forEach(function (el) {
          var target = parseInt(el.getAttribute('data-count-to') || '0', 10);

          function run() {
            if (prefersReduced || !target) {
              el.textContent = String(target);
              return;
            }
            var duration = 900;
            var start = null;
            function tick(ts) {
              if (start === null) start = ts;
              var p = Math.min((ts - start) / duration, 1);
              var eased = 1 - Math.pow(1 - p, 3);
              el.textContent = String(Math.round(target * eased));
              if (p < 1) requestAnimationFrame(tick);
            }
            requestAnimationFrame(tick);
          }

          if (el.hasAttribute('data-count-immediate')) {
            var delay = parseInt(el.getAttribute('data-count-delay') || '0', 10);
            setTimeout(run, delay);
          } else {
            var obs = new IntersectionObserver(function (entries, observer) {
              entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                  run();
                  observer.unobserve(entry.target);
                }
              });
            }, { threshold: 0.4 });
            obs.observe(el);
          }
        });
      });
    </script>
  </head>
  <body class="bg-dark font-sans antialiased text-cool-900">
    <slot />
  </body>
</html>
